rules_version = '2';

// Shared by the whole LiveHealthy suite (one Firebase project, one account):
//   - LiveHealthy Pill Reminder  (repo AwaizFatima08/Live_Healthy)
//   - LiveHealthy Vitals         (repo AwaizFatima08/vitals)
// Deploying from either repo replaces the rules for BOTH apps, so this file
// must be kept identical in both repos. Every Pill Reminder rule below is
// unchanged; Vitals only ADDS the vitalReadings and vitalReminders matches.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isPatientMember(patientId) {
      return isSignedIn() &&
        request.auth.uid in get(/databases/$(database)/documents/patients/$(patientId)).data.memberUids;
    }

    // Per-user profile: only the owner can read/write their own doc.
    match /users/{uid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;

      // [Vitals] Optional per-vital daily reminders, private to the user.
      match /vitalReminders/{reminderId} {
        allow read, delete: if isSignedIn() && request.auth.uid == uid;
        allow create, update: if isSignedIn() && request.auth.uid == uid && isValidReminder(request.resource.data);
      }
    }

    // A patient profile (self or a family member being managed).
    match /patients/{patientId} {
      // Reads `resource.data` directly rather than via isPatientMember()'s
      // get() — this rule also backs the `memberUids array-contains uid`
      // list query used to find a user's patients, and a self-referential
      // get() inside a list-query rule is rejected by Firestore as
      // PERMISSION_DENIED. get() stays correct (and necessary) below for
      // subcollection rules, where resource is a child doc and the parent
      // patient must be fetched separately.
      allow read: if isSignedIn() && request.auth.uid in resource.data.memberUids;
      // Creation: the creator must include themselves as owner + member.
      allow create: if isSignedIn() &&
        request.auth.uid == request.resource.data.ownerUid &&
        request.auth.uid in request.resource.data.memberUids;
      // Update/delete: only existing members, and ownerUid may not be reassigned to someone outside memberUids.
      allow update: if isPatientMember(patientId) &&
        request.resource.data.ownerUid in request.resource.data.memberUids;
      allow delete: if isSignedIn() && resource.data.ownerUid == request.auth.uid;

      match /medicines/{medicineId} {
        allow read, write: if isPatientMember(patientId);

        match /schedules/{scheduleId} {
          allow read, write: if isPatientMember(patientId);
        }
      }

      match /doseEvents/{eventId} {
        allow read, write: if isPatientMember(patientId);
      }

      match /purchases/{purchaseId} {
        allow read, write: if isPatientMember(patientId);
      }

      // [Vitals] Logged readings. Any caregiver of the patient can log,
      // edit or delete; the original author can't be rewritten.
      match /vitalReadings/{readingId} {
        allow read, delete: if isPatientMember(patientId);
        allow create: if isPatientMember(patientId) &&
          request.resource.data.createdByUid == request.auth.uid &&
          isValidReading(request.resource.data);
        allow update: if isPatientMember(patientId) &&
          request.resource.data.createdByUid == resource.data.createdByUid &&
          isValidReading(request.resource.data);
      }
    }

    // [Vitals] Shape checks — plausibility bounds match the app's
    // VitalValidation, so a buggy or malicious client can't store garbage.
    function isValidReading(d) {
      return d.measuredAt is timestamp &&
        (!('note' in d) || (d.note is string && d.note.size() <= 200)) &&
        (
          (d.type == 'bloodPressure' &&
            d.systolic is number && d.systolic >= 50 && d.systolic <= 300 &&
            d.diastolic is number && d.diastolic >= 30 && d.diastolic <= 200) ||
          (d.type == 'spo2' && d.value is number && d.value >= 50 && d.value <= 100) ||
          (d.type == 'pulse' && d.value is number && d.value >= 20 && d.value <= 250) ||
          (d.type == 'weight' && d.value is number && d.value >= 1 && d.value <= 400) ||
          (d.type == 'glucose' && d.value is number && d.value >= 10 && d.value <= 1000 &&
            d.glucoseContext in ['fasting', 'beforeMeal', 'afterMeal', 'random'])
        );
    }

    function isValidReminder(d) {
      return d.patientId is string &&
        d.type in ['bloodPressure', 'spo2', 'pulse', 'weight', 'glucose'] &&
        d.enabled is bool &&
        d.hour is int && d.hour >= 0 && d.hour <= 23 &&
        d.minute is int && d.minute >= 0 && d.minute <= 59;
    }
  }
}
